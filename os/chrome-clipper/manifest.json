{
  "manifest_version": 3,
  "name": "youlytics clipper",
  "version": "1.0.0",
  "description": "Save the page you're reading (or a selection) to knowledge/reading/ in youlytics-OS. Runs as plain code: no tokens.",
  "permissions": ["activeTab", "scripting", "contextMenus"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Save to youlytics", "default_icon": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}},
  "icons": {"16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png"}
}
