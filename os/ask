#!/usr/bin/env bash
# Start a chat on the agent, model and effort the router picks.
#   os/ask "draft a proposal for the Acme SAP dashboard"   -> Claude Code
#   os/ask "write a script that renames these CSV files"    -> may go to Codex
#   os/ask /grammar "check this paragraph"                  -> pinned skill, Claude haiku
set -euo pipefail
cd "$(dirname "$0")/.."
read -r model effort < <(python3 os/router/route.py "$*")
if [ "$model" = "codex" ]; then
  echo "Routing: Codex (ChatGPT plan), $effort effort" >&2
  exec codex -c model_reasoning_effort="$effort" "$*"
fi
echo "Routing: Claude $model, $effort effort" >&2
exec claude --model "$model" --effort "$effort" "$*"
